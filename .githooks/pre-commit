#!/bin/sh
#
# pre-commit: 민감 정보(개인키 / 서명 자격증명 / 코드 내 실 AdMob ID 등) 커밋 방지.
#
# 1회 활성화 (저장소 루트에서):
#   git config core.hooksPath .githooks
#
# 비활성화:
#   git config --unset core.hooksPath
#
# 동작 원리
#   - Firebase API 키는 설계상 앱에 내장되는 공개 값이므로, 빌드 필수 설정 파일
#     (firebase_options.dart, google-services.json)에 있는 키는 허용한다.
#   - AdMob 테스트 ID(ca-app-pub-3940256099942544...) 및 네이티브 필수 위치
#     (AndroidManifest.xml, Info.plist)는 허용한다. 그 외 파일에 실 AdMob ID를
#     하드코딩하면 차단한다 (광고 정책상 개발 중 실 ID 사용 금지).
#   - 개인키, key.properties, .jks/.keystore/.p12 등 진짜 비밀은 항상 차단한다.
#   - 수정 파일에서는 "추가되는 줄(+)만" 검사한다 (삭제되는 줄은 새 노출이 아니므로 제외).

set -e

# ---------------------------------------------------------------- 도구 확인
if command -v grep >/dev/null 2>&1; then
  GREP=grep
elif [ -x /usr/bin/grep ]; then
  GREP=/usr/bin/grep
elif [ -x /bin/grep ]; then
  GREP=/bin/grep
else
  echo "ERROR: 이 훅은 grep이 필요합니다 (Git Bash가 설치되어 있는지 확인)." >&2
  exit 1
fi

# ---------------------------------------------------------------- 허용 목록
# Firebase 공개 키 포함 빌드 필수 파일 (설계상 공개).
FIREBASE_ALLOWED_FILES='lib/firebase_options.dart android/app/google-services.json'
# AdMob App ID가 반드시 있어야 하는 네이티브 설정 파일 (공개 식별자).
AD_CONFIG_FILES='android/app/src/main/AndroidManifest.xml android/app/src/debug/AndroidManifest.xml android/app/src/profile/AndroidManifest.xml ios/Runner/Info.plist macos/Runner/Info.plist ios/Runner/GoogleService-Info.plist'
# 훅 자기 자신도 검사에서 제외 (자기 참조 방지).
ALLOWED_FILES="$FIREBASE_ALLOWED_FILES $AD_CONFIG_FILES .githooks/pre-commit"

# ---------------------------------------------------------------- 커밋 금지 파일
BLOCKED_FILES='*key.properties *.jks *.keystore *.p12 *.mobileprovision'

# 구글 공식 테스트 AdMob 접두사 (항상 허용)
TEST_ADMOB_PREFIX='ca-app-pub-3940256099942544'

fail() {
  echo "ERROR: $1" >&2
  echo "" >&2
  echo "대응 방법:" >&2
  echo "  1) 해당 문자열을 코드에서 제거하고 --dart-define(또는 환경변수)로 주입하세요." >&2
  echo "  2) 빌드 필수 공개 값이라면 훅 상단의 FIREBASE_ALLOWED_FILES / AD_CONFIG_FILES에 파일을 추가하세요." >&2
  echo "  3) 이미 외부에 공개된 진짜 비밀이라면 회전(재생성)하세요." >&2
  exit 1
}

# 스테이징된 파일의 "추가될 내용"만 출력
#  - 신규(Added) 파일: 전체 내용
#  - 수정(Modified) 파일: diff에서 +로 시작하는 줄만
scan_staged() {
  f="$1"
  if git diff --cached --name-status -- "$f" 2>/dev/null | "$GREP" -q "^A"; then
    git show ":$f" 2>/dev/null
  else
    git diff --cached -U0 -- "$f" 2>/dev/null | "$GREP" "^+"
  fi
}

# ---------------------------------------------------------------- 스테이징 파일
FILES=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null || true)
[ -z "$FILES" ] && exit 0

for f in $FILES; do
  # 1) 커밋 금지 파일 유형 (gitignore 외 이중 방어)
  for b in $BLOCKED_FILES; do
    case "$f" in
      $b)
        fail "커밋 금지 파일이 스테이징되었습니다: $f (git reset HEAD -- \"$f\")"
        ;;
    esac
  done

  # 2) 허용 목록 파일은 스캔 생략
  allowed=0
  for a in $ALLOWED_FILES; do
    [ "$f" = "$a" ] && allowed=1
  done
  [ "$allowed" = "1" ] && continue

  content=$(scan_staged "$f")

  # 3) 개인키 헤더 (모든 파일)
  if printf '%s\n' "$content" | "$GREP" -E -- '-----BEGIN [A-Z ]*PRIVATE KEY' >/dev/null; then
    fail "개인키(PRIVATE KEY)가 감지되었습니다: $f"
  fi

  # 4) AdMob ID — 테스트 접두사 제외, 네이티브 설정 파일 외 하드코딩 차단
  is_ad_config=0
  for c in $AD_CONFIG_FILES; do
    [ "$f" = "$c" ] && is_ad_config=1
  done
  if [ "$is_ad_config" = "0" ]; then
    if printf '%s\n' "$content" | "$GREP" -E -- 'ca-app-pub-[0-9]{16}(~|/)[0-9]{10}' | "$GREP" -v -- "$TEST_ADMOB_PREFIX" >/dev/null; then
      fail "실행 AdMob ID가 코드에 하드코딩되었습니다: $f (테스트 ID 또는 --dart-define 사용)"
    fi
  fi

  # 5) Firebase/Google API 키 — 허용 파일 외 노출 차단
  if printf '%s\n' "$content" | "$GREP" -E -- 'AIza[0-9A-Za-z_-]{20,}' >/dev/null; then
    fail "Firebase/Google API 키가 코드에 노출되었습니다: $f"
  fi
done

exit 0